<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Plain http, DEBUG ONLY. AppConfig's default origin is
         http://10.0.2.2:8000 (the emulator's route to a local Laravel), so
         development needs cleartext — but shipping it in the release APK means
         a driver's GPS trail and a manifest of children's names and guardian
         numbers can travel unencrypted on any misconfigured deployment. The
         release manifest sets usesCleartextTraffic="false"; this overlay is why
         that is safe to do. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
